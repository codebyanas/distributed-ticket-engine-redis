{
  "name": "distributed-ticket-engine-redis",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty --translateTime HH:MM:ss Z --ignore pid,hostname,req,res,env",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "docker": "docker compose up -d postgres redis",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:status": "docker compose ps",
    "ci:local": "scripts\\ci-local.cmd",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:concurrency": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/concurrency --runInBand",
    "benchmark": "node benchmarks/autocannon.mjs hold-hotspot",
    "benchmark:hold": "node benchmarks/autocannon.mjs hold-pool",
    "benchmark:hotspot": "node benchmarks/autocannon.mjs hold-hotspot",
    "benchmark:geo": "node benchmarks/autocannon.mjs geo-search",
    "benchmark:orders": "node benchmarks/autocannon.mjs orders",
    "benchmark:rate-limit": "autocannon -c 20 -d 5 http://localhost:5000/api/v1/rate-limit-test",
    "benchmark:k6": "k6 run benchmarks/k6.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}